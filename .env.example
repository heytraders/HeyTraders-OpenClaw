# Copy to .env for local Docker development. Never commit .env.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.8.2-browser@sha256:e164a318801fad2d49dc19b99adadfa629fa5f9ffb43673e73661c1d3f9cc7de
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_TZ=Asia/Seoul

# Generate locally with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Host-side persistent state. These paths are ignored by Git.
OPENCLAW_CONFIG_DIR=./.openclaw-docker/state
OPENCLAW_WORKSPACE_DIR=./.openclaw-docker/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=./.openclaw-docker/auth-profile-secrets
OPENCLAW_CACHE_DIR=./.openclaw-docker/cache
